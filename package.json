    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
