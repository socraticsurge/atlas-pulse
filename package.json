{
  "name": "atlas-pulse",
  "private": true,
  "version": "1.4.0",
  "description": "Privacy-first RSS feed reader with on-device AI: Gemini Nano built into Chrome, or optional local Ollama models. No cloud, no accounts, your data never leaves your machine.",
  "license": "MIT",
  "author": "Vinay Chaganti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socraticsurge/atlas-pulse.git"
  },
  "bugs": {
    "url": "https://github.com/socraticsurge/atlas-pulse/issues"
  },
  "homepage": "https://github.com/socraticsurge/atlas-pulse#readme",
  "keywords": [
    "rss",
    "rss-reader",
    "feed-reader",
    "ollama",
    "local-ai",
    "on-device-ai",
    "chrome-built-in-ai",
    "gemini-nano",
    "local-first",
    "privacy",
    "react",
    "express"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test",
    "preview": "vite preview",
    "service": "scripts/service.sh"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.1.0",
