    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "docx": "^9.11.0",
    "dompurify": "^3.4.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "marked": "^18.0.14",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "7.29.1"
  },
  "devDependencies": {
